# Server-only: required for AI reports (optional for scanner). Never use VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3000

# Firebase public web app configuration; authentication will remain disabled until set.
# Configure Google and Email/Password providers in Firebase Authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
