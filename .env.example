# Public build settings (never put server secrets under VITE_)
VITE_API_BASE_URL=
VITE_BASE_PATH=/
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Node development adapter
PORT=3000
LOCAL_DATABASE=local.sqlite
ALLOWED_ORIGIN=http://localhost:3000
# Server secrets: use `wrangler secret put NAME` for production
RATE_LIMIT_SALT=
DATA_PROVIDER_URL=
DATA_PROVIDER_KEY=
DATA_PROVIDER_NAME=
# Set true only after verifying your supplier's permitted use and retention rights.
DATA_PROVIDER_APPROVED=false
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated Supabase user UUIDs. Never use user-editable metadata for roles.
ADMIN_USER_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
