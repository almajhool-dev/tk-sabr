NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20
# Set only to the actual number of trusted reverse-proxy hops:
TRUST_PROXY_HOPS=
# Frontend public configuration, baked into the Vite build:
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Backend secrets; NEVER prefix with VITE_:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Official TikTok Display API; token owner consent, not arbitrary username search.
TIKTOK_ACCESS_TOKEN=
TIKTOK_VIDEO_SCOPE=false
# Alternative: contracted authorized provider implementing docs/API.md contract.
DATA_PROVIDER_URL=
DATA_PROVIDER_KEY=
DATA_PROVIDER_NAME=
DATA_PROVIDER_AUTHORIZED=false
# Optional OpenAI-compatible AI API
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Opt-in integration test, account you are authorized to query:
LIVE_TEST_USERNAME=
